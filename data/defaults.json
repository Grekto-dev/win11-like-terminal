{
    "language": "en",
    "defaultProfile": "",
    "initialCols": 120,
    "initialRows": 30,
    "launchMode": "default",
    "alwaysOnTop": false,
    "copyOnSelect": false,
    // Ours, not the original's (false there: right click copies or pastes, the menu only on the Menu key):
    // the context menu opens on right click. Set it to false in settings.json for the original's behavior.
    "experimental.rightClickContextMenu": true,
    "copyFormatting": false,
    "trimBlockSelection": true,
    "trimPaste": true,
    "wordDelimiters": " /\\()\"'-.,:;<>~!@#$%^&*|+=[]{}~?│",
    "alwaysShowTabs": true,
    "showTabsInTitlebar": true,
    "showTerminalTitleInTitlebar": true,
    "tabWidthMode": "equal",
    "tabSwitcherMode": "inOrder",
    "confirmCloseAllTabs": true,
    "theme": "dark",
    "snapToGridOnResize": true,
    "disableAnimations": false,
    "focusFollowMouse": false,
    "minimizeToNotificationArea": false,
    "alwaysShowNotificationIcon": false,
    "startupActions": "",
    "profiles": {
        "defaults": {
            "colorScheme": "Campbell",
            "antialiasingMode": "grayscale",
            "closeOnExit": "automatic",
            "cursorShape": "bar",
            "fontFace": "Cascadia Mono",
            "fontSize": 12,
            "hidden": false,
            "historySize": 9001,
            "padding": "8, 8, 8, 8",
            "snapOnInput": true,
            "altGrAliasing": true,
            "startingDirectory": "~",
            "useAcrylic": false,
            "icon": "terminal"
        },
        "list": []
    },

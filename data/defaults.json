    "keybindings": [
        {
            "keys": "alt+f4",
            "id": "Terminal.CloseWindow"
        },
        {
            "keys": "alt+enter",
            "id": "Terminal.ToggleFullscreen"
        },
        {
            "keys": "f11",
            "id": "Terminal.ToggleFullscreen"
        },
        {
            "keys": "ctrl+shift+space",
            "id": "Terminal.OpenNewTabDropdown"
        },
        {
            "keys": "ctrl+,",
            "id": "Terminal.OpenSettingsUI"
        },
        {
            "keys": "ctrl+shift+,",
